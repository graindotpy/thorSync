# Copy this file to .env and replace every value marked CHANGE_ME.

# Published application image. The edge tag is updated only after CI passes.
THORSYNC_IMAGE=ghcr.io/apgul/thorsync:edge

# ZimaOS storage root and runtime identity. PUID/PGID must own this directory.
THORSYNC_ROOT=/DATA/AppData/thorsync
PUID=1000
PGID=1000
TZ=Europe/London

# Bind the local fallback port to loopback. Cloudflare Tunnel reaches the
# container over CLOUDFLARE_NETWORK and does not require a public host port.
THORSYNC_BIND_ADDRESS=127.0.0.1
THORSYNC_PORT=8080
CLOUDFLARE_NETWORK=thorsync-cloudflare

# Cloudflare Access application settings. Keep the audience and administrator
# email in files under ${THORSYNC_ROOT}/secrets, not in this file.
THORSYNC_CF_ISSUER=https://CHANGE_ME.cloudflareaccess.com
# Optional. Leave empty to derive <issuer>/cdn-cgi/access/certs.
THORSYNC_CF_JWKS_URL=

# Archive protection defaults: 5 GiB warning quota and 1 GiB free-space floor.
THORSYNC_SOFT_QUOTA_BYTES=5368709120
THORSYNC_RESERVE_BYTES=1073741824
THORSYNC_RECONCILE_INTERVAL=15m

# Syncthing is intentionally pinned and is not updated by WUD.
SYNCTHING_VERSION=2.1.5
SYNCTHING_GUI_BIND_ADDRESS=127.0.0.1
SYNCTHING_GUI_PORT=8384
SYNCTHING_SYNC_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027

# WUD is intentionally pinned and its UI is not published.
WUD_VERSION=8.4.0
WUD_LOG_LEVEL=info
